[Unit]
Description=unifi-allowlist agent, nftables mode (syncs verified player IPs into local nftables sets)
Documentation=https://github.com/AussieH/unifi-allowlist
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=unifi-allowlist
Group=unifi-allowlist
ExecStart=/usr/bin/node /opt/unifi-allowlist/unifi-allowlist-agent.js --config /etc/unifi-allowlist/config.json
Restart=always
RestartSec=15

# nft needs CAP_NET_ADMIN and a netlink socket; nothing else.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# No MemoryDenyWriteExecute: Node's JIT needs writable+executable pages and dies with SIGTRAP without them.
SystemCallArchitectures=native
ReadOnlyPaths=/etc/unifi-allowlist

StandardOutput=journal
StandardError=journal
SyslogIdentifier=unifi-allowlist

[Install]
WantedBy=multi-user.target
